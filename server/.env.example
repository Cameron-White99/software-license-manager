PORT=5000
# In production on EC2, set PORT=80 (or 3000 behind a security-group rule) so
# the app is reachable at the plain public URL without a port number.
MONGO_URI=mongodb://localhost:27017/license-manager
# For EC2 deployment, point this at a MongoDB Atlas connection string instead
# of a local MongoDB install — avoids installing/managing a DB server on the instance.
